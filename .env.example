# Qwen3.8-Flash-Next NVFP4 (RadixArk) on DGX Spark (GB10/SM121) -- 4x180k, MTP3, FP8-KV.
#
# Profiles: k3 (default), mia (k3 + MiaAI reduced draft vocab + MADV_RANDOM)
# and hybrid (mia + FP8-hybrid checkpoint) -- see below; never in parallel.
# Native MTP3 (MTP layers are part of the checkpoint -- no external drafter).
#
# KV budgeting via --kv-cache-memory-bytes (hard bytes): vLLM then sizes
# KV exactly and ignores gpu_memory_utilization for KV sizing
# only (vllm/config/cache.py). The startup pool check
# (request_memory: free >= gpu_memory_utilization * total) stays in force --
# hence the explicit QFN_GPU_MEMORY_UTILIZATION (vLLM default 0.92 would be
# 111.95 GiB and crashes; 0.80 -> ~97.4 GiB pool: weights ~78 + KV 11.6 +
# MTP ~1.5 + overhead ~4-6 GiB).
#
# Image chain: official Qwen3.8-Flash-Next image (digest pin in the build
# repo's Dockerfile) + blazux/qwen3.8-Flash-DGX @ BUILD_COMMIT
# (PLE-mmap, GB10 fixes, deterministic QSA top-k, FP8-KV patch,
# PLE range-guard). Build: ./scripts/qwen38f-vllm.sh build-image

MODEL_DIR=../Qwen3.8-Flash-Next-NVFP4-RadixArk
# Cache directories (bind-mounted into the container). Left empty = the start
# script's defaults: ${HOME}/.cache/huggingface, ${HOME}/.cache/vllm, ${HOME}/.triton
# (${HOME} is resolved by the script, not from this file).
# Only set these if a cache deliberately lives outside the home directory.
# HF_CACHE_DIR=/path/.cache/huggingface
# VLLM_CACHE_DIR=/path/.cache/vllm
# TRITON_CACHE_DIR=/path/.triton
# Patched Flash-Next image (default: built locally, tag named after the build commit).
# build-image fetches the build repo into ${WORKSPACE_DIR}/qwen3.8-Flash-DGX.
VLLM_IMAGE=qwen38-flash-dgx:656cdb0
# Mia layer image = VLLM_IMAGE + ONE layer with two anchor-verified pins:
# reduced-vocab MTP patch + MADV_RANDOM for PLE-mmap (mia/Dockerfile).
# Build once: ./scripts/qwen38f-vllm.sh build-image-mia
MIA_IMAGE=qwen38-flash-mia:2
# Public draft-vocabulary build settings (vocab-public).
DRAFT_VOCAB_ENGLISH_WEIGHT=1
DRAFT_VOCAB_GERMAN_WEIGHT=3
DRAFT_VOCAB_CODE_WEIGHT=3
DRAFT_VOCAB_SIZE=65536
SERVED_MODEL_NAME=qwen3.8-flash-next
VLLM_PORT=44415
RESTART_POLICY=no

# Shared defaults.
OMP_NUM_THREADS=4
VLLM_LOGGING_LEVEL=INFO
# The container resolves the main model (local via bind) offline.
HF_HUB_OFFLINE=1

# PLE-mmap (48 GB FP8 n-gram tables live in the checkpoint dir, NVMe):
QFN_PLE_MMAP_WORKERS=32
# 1 = stream the table once at boot (steady first-request latency,
# ~10 s extra). 0 = the page cache warms up naturally.
QFN_PLE_MMAP_PREWARM=0
# MADV_RANDOM on the PLE shard views: suppresses read-ahead for the
# random n-gram lookups and keeps up to ~2 GiB of unused page-cache
# fill out of the LPDDR5X pool (MiaAI: 1366 vs 57 KiB SSD read per decoded
# token). Effective in the MIA_IMAGE only (mia/hybrid); k3/base ignore the
# value, unpatched. 0 = off (behaviour as in base).
QFN_PLE_MMAP_MADV_RANDOM=1
# Deterministic QSA top-k (GB10: the stock kernel drops candidates):
QFN_QSA_DET_TOPK=1
# 1 = exact torch.topk fallback (deterministic, but -20-40 % on long prefill).
QFN_QSA_EXACT_TOPK=0

# Server profile k3 (baseline profile).
# Native RoPE (262144), no YaRN: 180000 is below the native max length.
QFN_MAX_MODEL_LEN=180000
# 4 parallel requests = the requirement (a KV limit, not a throughput knob).
QFN_MAX_NUM_SEQS=4
# Native MTP: 3 speculative tokens. K-sweep (MiaAI-Lab, 06.09.2026, same
# Spark type): K=3 wins at every concurrency, K=2 on par, K=1 -8-14 %.
QFN_MTP_NUM_SPECULATIVE_TOKENS=3
# FP8-KV on the QSA path: required so that 4 x 180k = 720k are resident
# at once ("auto" = BF16, better quality, but only ~737k-800k capacity).
# Data point 08.09.2026 (own boot, identical image): 16 GiB -> 1,047,937
# tokens (5.82x at 180k), 16,394 B/token.
QFN_KV_CACHE_DTYPE=fp8_e4m3
# GDN/Mamba recurrent state: the checkpoint grows it as float32; bfloat16 halves
# the ~0.23 GB/seq traffic (measured +8.5 % decode @ 8 streams, acceptance/needles
# unchanged -- MiaAI-Lab, 06.09.2026).
QFN_MAMBA_SSM_CACHE_DTYPE=bfloat16
# Hard KV budgeting (KV sizing ignores gpu-memory-utilization when set):
#   Target: 4 x 180000 tokens = 720000 tokens resident. The budget is sized for
#   4 x 190000 = 760000 tokens (190k = accepted upper bound per
#   stream, ~5 % margin over the 180k working context); the client caps
#   requests anyway, and every GiB of KV is missing for PLE page cache +
#   other host processes.
#   Data point (own boot, 08.09.2026, identical image/config):
#     16 GiB = 17179869184 bytes -> 1,047,937 tokens = 5.82x at 180k (16,394 B/token).
#   11.60 GiB = 12459440000 bytes -> exactly 760,000 tokens = 4.22x (760k x
#   16,394 B); old 14.1 GiB (4x230k) was ~923.5k tokens = ~2.5 GiB too much.
#   vLLM lowercase suffix: 12g would be 12,000,000,000 bytes = 11.18 GiB (too small).
#   If the reported capacity drops below 720k: 13.5 GiB = 14495514624.
QFN_KV_CACHE_MEMORY_BYTES=12459440000
# Shared scheduler step budget for prefill and decode across all requests.
# Production value for k3, mia and hybrid; no per-request prefill cap.
QFN_MAX_NUM_BATCHED_TOKENS=8192
# Mia profile: k3 + reduced MTP draft vocab (mia/draft_vocab_public.txt), explicit
# CUDA graph capture widths [4,8,12,16] = (1+3)*S for S=1..4 and
# VLLM_USE_V2_MODEL_RUNNER=1. A/B testing only (never in parallel with k3);
# runbook + vocab provenance: mia/README.md. Same 8192 step budget as k3.
QFN_MIA_MAX_NUM_BATCHED_TOKENS=8192
QFN_MIA_CUDAGRAPH_CAPTURE_SIZES=4,8,12,16
# Mia/hybrid additionally use the MADV_RANDOM patch in the image (see above).
# Historical PLE prefetch experiment: no measured production improvement.
# The effective prefill/decode tuning is the 8192-token scheduler budget.
# Hybrid profile only -- that is where the patched module is bind-mounted
# (see ple_patches/). 1 = on (this is what the reference host runs with),
# 0 = off (exactly the previous behaviour). k3/base ignore the value.
QFN_PLE_MMAP_PREFETCH=1

# Hybrid profile: mia + an FP8-hybrid snapshot produced locally from the
# RadixArk checkpoint (~15 GiB BF16 side layers -> blockwise FP8;
# NVFP4 experts unchanged). Reference blazux/qwen3.8-Flash-DGX:
# ~7 GiB fewer resident weights, ~+20 % decode, same quality.
# Produce once: ./scripts/qwen38f-vllm.sh prepare-hybrid (the server
# must be down; hardlink snapshot; four shards are converted into new files.
# Unchanged shards share storage with the original checkpoint).
QFN_HYBRID_MODEL_DIR=../Qwen3.8-Flash-Next-NVFP4-RadixArk-fp8hybrid
# DeepGEMM off (the blockwise FP8 kernel path of the side layers; blazux
# serve.sh sets VLLM_FP8_HYBRID=1 + VLLM_USE_DEEP_GEMM=0 together):
QFN_HYBRID_USE_DEEP_GEMM=0
# Lower bounds for prepare-hybrid (commented out = defaults 12 GiB free
# space / 20 GiB MemAvailable). Only lower them for dry runs: the converter
# keeps one whole shard (model-bf16-00011 = 9.99 GiB) in RAM, so
# it wants the field to itself -- the server being down is a hard prerequisite.
# QFN_HYBRID_MIN_FREE_GIB=12
# QFN_HYBRID_MIN_AVAIL_GIB=20
# Note on KV after hybrid: the hard KV budget does NOT grow automatically
# with the ~7 GiB saved (it flows back into the system pool).
# To invest it in KV instead: raise QFN_KV_CACHE_MEMORY_BYTES
# to e.g. 14495514624 (13.5 GiB, ~877k tokens) -- switch only after
# a verified hybrid boot.
# Draft-vocab file that the mia profile mounts as /root/draft_vocab.txt
# (read-only; rebuild: ./scripts/qwen38f-vllm.sh vocab-public).
DRAFT_VOCAB_FILE=./mia/draft_vocab_public.txt
# Pool cap: vLLM default 0.92 -> demands 111.95 GiB (fails on a host where
# other processes hold memory too). 0.80 x 121.69 GiB = 97.4 GiB pool: weights
# ~78 + KV 11.6 + MTP ~1.5 + profile run/cudagraphs ~4-6 GiB (~95-97, tight
# but with margin). If the pool check narrowly fails: lower to 0.78 (~94.9).
# If the start crashes with "KV cache is needed, larger than available":
# raise to 0.85 (~103.4) (the reference serve default).
QFN_GPU_MEMORY_UTILIZATION=0.80